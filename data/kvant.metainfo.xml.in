<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<component type="desktop-application">
  <id>@KVANT_APP_ID@</id>
  <name>Kvant</name>
  <summary>A clean Material 3 audio player</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.proshiv85_byte">
    <name>rDev</name>
  </developer>
  <description>
    <p>
      Kvant is a lightweight audio player with a Material 3 look: a squiggly progress
      bar, a morphing play button and a full color scheme generated from one accent color.
    </p>
    <ul>
      <li>Play a single file, or open a folder as a queue</li>
      <li>Queue panel on the left or right</li>
      <li>Shuffle, repeat all and repeat one</li>
      <li>Picks up where you left off: the queue, track and position are restored on start</li>
      <li>Light, dark or system theme with any accent color</li>
      <li>Adjustable squiggly progress bar</li>
      <li>Drag and drop, media keys and desktop media controls (MPRIS)</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>Playing a folder, light theme</caption>
      <image>https://raw.githubusercontent.com/proshiv85-byte/kvant/main/docs/screenshots/desktop-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Dark theme with a teal accent and the queue on the right</caption>
      <image>https://raw.githubusercontent.com/proshiv85-byte/kvant/main/docs/screenshots/desktop-dark.png</image>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">@KVANT_APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/proshiv85-byte/kvant</url>
  <url type="bugtracker">https://github.com/proshiv85-byte/kvant/issues</url>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.2.0" date="2026-10-15">
      <description>
        <ul>
          <li>Shuffle, repeat all and repeat one, also over MPRIS</li>
          <li>Picks up where you left off: the queue, track and position are restored on start</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-14"/>
  </releases>
</component>
